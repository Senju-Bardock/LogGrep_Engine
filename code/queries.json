{
  "levels": {
    "CRITICAL": ["CRITICAL", "FATAL"],
    "ERROR": ["ERROR"],
    "WARN": ["WARN", "WARNING"],
    "INFO": ["INFO"],
    "DEBUG": ["DEBUG", "TRACE"]
  },
  "profiles": {
    "errors": {
      "description": "Application errors and critical failures",
      "patterns": ["ERROR", "CRITICAL", "FATAL"],
      "exclude": ["healthcheck", "internal-ping"],
      "severity": "ERROR"
    },
    "warnings": {
      "description": "Application warnings",
      "patterns": ["WARN"],
      "exclude": ["healthcheck"],
      "severity": "WARN"
    },
    "security_audit": {
      "description": "Failed and unauthorized access attempts",
      "patterns": ["Failed password", "Invalid user", "Unauthorized"],
      "exclude": ["healthcheck", "internal-ping"],
      "severity": "ERROR"
    },
    "api_performance": {
      "description": "HTTP 500 errors, timeouts and database connection losses",
      "patterns": ["HTTP/1.1\" 500", "Timeout", "Database connection lost"],
      "severity": "CRITICAL"
    },
    "ips": {
      "description": "Any line containing an IP address",
      "regex": ["(\\d{1,3}\\.){3}\\d{1,3}"],
      "exclude": ["healthcheck"]
    }
  }
}
